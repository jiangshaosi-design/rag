# ===== 环境变量（含密钥，绝不提交）=====
.env
.env.local
.env.*.local

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/

# ===== 运行时数据 =====
# 全部为本地文档解析产物，体积大且含业务数据，不提交
data/uploads/*
data/faiss_index/*
data/images/*
data/mineru_output/*
data/mineru_models/*
# 保留目录结构本身
!data/uploads/.gitkeep
!data/faiss_index/.gitkeep
!data/images/.gitkeep
!data/mineru_output/.gitkeep
!data/mineru_models/.gitkeep

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志与临时文件 =====
*.log
tmp/
temp/
