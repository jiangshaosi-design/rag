# ============================================================
# 复制本文件为 .env 并填入真实值：
#     cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
# 请勿把真实密钥写回本文件（.env.example 是会被提交的模板）。
# ============================================================

# ===== DeepSeek LLM =====
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# Agent 最大推理步数（ReAct 循环上限，超出则中断）
AGENT_MAX_ITERATIONS=25

# ===== 阿里云 DashScope（Embedding + 视觉）=====
# 申请地址: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v4
VISION_MODEL=qwen-vl-plus

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=rag_kb

# ===== FAISS =====
FAISS_INDEX_PATH=data/faiss_index

# ===== 分块（递归粗分 + 滑动窗口细分）=====
RECURSIVE_CHUNK_SIZE=1000
RECURSIVE_CHUNK_OVERLAP=100
SLIDING_WINDOW_SIZE=500
SLIDING_STEP=250

# ===== 文档解析 =====
# MinerU 后端: pipeline(快) / vllm(精，需更强 GPU)
MINERU_BACKEND=pipeline
IMAGE_DIR=data/images
# 是否调用 Qwen-VL 描述图片（关闭可省 API 费用，但图表内容无法被检索到）
IMAGE_DESCRIBE=true
# 单文档上限保护，超出则中止入库
MAX_CHUNKS_PER_DOC=5000
MAX_IMAGES_PER_DOC=1000

# ===== 应用 =====
UPLOAD_DIR=data/uploads
TOP_K=5
